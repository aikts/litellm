# Public overlay image.
#
# Takes the upstream-published litellm-database image and layers our open-source
# Python patches on top. No private dependencies — safe to publish to ghcr.io.
#
# Build args:
#   BASE_IMAGE   - upstream image, e.g. ghcr.io/berriai/litellm-database:v1.100.0
#
# To patch a new file:
#   1. Edit it in the source tree (litellm/<path>).
#   2. Add ONE line below the "PATCHED FILES" marker that mirrors the same
#      relative path into /tmp/overlay/. No second copy to keep in sync.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# ---- PATCHED FILES (add one COPY per patched file, keep the source path) ----
COPY litellm/cost_calculator.py /tmp/overlay/litellm/cost_calculator.py
COPY litellm/images/main.py /tmp/overlay/litellm/images/main.py
COPY litellm/litellm_core_utils/streaming_handler.py /tmp/overlay/litellm/litellm_core_utils/streaming_handler.py
COPY litellm/llms/openrouter/chat/transformation.py /tmp/overlay/litellm/llms/openrouter/chat/transformation.py
COPY litellm/main.py /tmp/overlay/litellm/main.py
COPY litellm/proxy/proxy_server.py /tmp/overlay/litellm/proxy/proxy_server.py
COPY litellm/responses/litellm_completion_transformation/transformation.py /tmp/overlay/litellm/responses/litellm_completion_transformation/transformation.py
# ---- end patched files ----

# Resolve the canonical site-packages litellm install (where uvicorn/CMD imports
# from) via sysconfig — NOT `import litellm` which can be shadowed by /app/litellm
# when cwd is on sys.path. Then mirror the overlay into every importable copy so
# it is patched regardless of which one Python ends up resolving at runtime.
#
# /app is on sys.path because proxy_cli puts the working directory there, so a
# litellm package under it has to be patched too. Upstream stopped shipping the
# source tree in the runtime image in 1.100 and now leaves only a stub there
# (litellm/proxy/prisma_migration.py, no __init__.py); that stub is never
# imported as a package, so copying into it would be dead weight.
#
# The final loop is the safety net: the overlay copies files by name, so a
# missing COPY above, a renamed upstream path or a moved install layout yields an
# image that starts and serves traffic WITHOUT the patches, silently. Fail the
# build instead of shipping that.
RUN PURELIB="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    TARGETS="$PURELIB/litellm" && \
    if [ -f /app/litellm/__init__.py ]; then TARGETS="$TARGETS /app/litellm"; fi && \
    for d in $TARGETS; do \
      cp -rv /tmp/overlay/litellm/. "$d/" && \
      find "$d" -name '__pycache__' -type d -exec rm -rf {} + ; \
    done && \
    for f in $(cd /tmp/overlay/litellm && find . -type f); do \
      cmp -s "/tmp/overlay/litellm/$f" "$PURELIB/litellm/$f" || \
        { echo "PATCH DID NOT LAND: litellm/$f"; exit 1; }; \
    done && \
    rm -rf /tmp/overlay
